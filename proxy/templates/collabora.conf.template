server {
	listen ${NGINX_PORT_HTTPS} ssl;
	server_name collabora.${DOMAIN};

	ssl_certificate /etc/letsencrypt/live/collabora.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/collabora.${DOMAIN}/privkey.pem;

	location / {
		proxy_pass http://collabora:9980;

		# Standard proxy headers
	   	include /etc/nginx/snippets/proxy-headers.conf;

		# WebSocket support (safe to keep even if not needed)
	   	include /etc/nginx/snippets/websocket-support.conf;
		proxy_read_timeout 360000s;
	}

	# static files
	location ^~ /browser {
		proxy_pass http://collabora:9980;
		proxy_set_header Host $host;
	}


	# WOPI discovery URL
	location ^~ /hosting/discovery {
		proxy_pass http://collabora:9980;
		proxy_set_header Host $host;
	}


	# Capabilities
	location ^~ /hosting/capabilities {
		proxy_pass http://collabora:9980;
		proxy_set_header Host $host;
	}

	# main websocket, download, presentation (legacy svg) and image upload
	location ^~ /cool/ {
		proxy_pass http://collabora:9980;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "Upgrade";
		proxy_set_header Host $host;
		proxy_read_timeout 36000s;
	}
}
